# .env.example
# Server-only secrets. Never prefix secrets with VITE_.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# gemini (default), openai, or groq
AI_PROVIDER=gemini
OPENAI_MODEL=gpt-5-mini

# Comma-separated browser origins, for example:
# ALLOWED_ORIGINS=https://basira.example.com,http://localhost:3000
ALLOWED_ORIGINS=

# Optional public backend URL used by the web/mobile client.
VITE_API_URL=

# Google Play subscription IDs. These are public identifiers created in Play Console.
# The client and server values MUST refer to the exact same subscription/base plan.
VITE_PLAY_SUBSCRIPTION_PRODUCT_ID=
VITE_PLAY_SUBSCRIPTION_BASE_PLAN_ID=
PLAY_SUBSCRIPTION_PRODUCT_ID=
PLAY_SUBSCRIPTION_BASE_PLAN_ID=

# Server-only Google service-account credentials. Supply raw JSON or base64-encoded JSON.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON needs Google Play Android Developer API access.
# FIREBASE_SERVICE_ACCOUNT_JSON needs Firestore write access. If omitted, the Play
# service account is reused and must also have Firestore permission.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON=
