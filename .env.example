# .env.example
# Server-only secrets. Never prefix secrets with VITE_.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# gemini (default), openai, or groq
AI_PROVIDER=gemini
OPENAI_MODEL=gpt-5-mini

# Comma-separated browser origins, for example:
# ALLOWED_ORIGINS=https://basira.example.com,http://localhost:3000
ALLOWED_ORIGINS=

# Optional public backend URL used by the web/mobile client.
VITE_API_URL=

# Google Play subscription Product IDs. Keep empty until these exact products
# exist and are active in Play Console. Never invent IDs in source code.
VITE_PLAY_ADEPT_PRODUCT_ID=
VITE_PLAY_ORACLE_PRODUCT_ID=

# Legacy hosted checkout fallback. Do not use this to grant Android Play
# entitlements. Google Play subscription purchases must use Play Billing.
VITE_CHECKOUT_URL=
