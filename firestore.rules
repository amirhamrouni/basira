rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // New accounts may only create the safe default role/subscription.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.vipStatus == 'none';

      // Users cannot promote themselves or grant themselves a subscription.
      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.vipStatus == resource.data.vipStatus
        && request.resource.data.energy is int
        && request.resource.data.energy >= 0
        && request.resource.data.energy <= 500);

      allow delete: if isOwner(userId) || isAdmin();

      match /readings/{readingId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.type is string
          && request.resource.data.result is string
          && request.resource.data.result.size() <= 12000;
        allow update: if false;
      }
    }

    // Block all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
