rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function premiumFields() {
      return [
        'vipStatus',
        'premiumUntil',
        'premiumProductId',
        'premiumBasePlanId',
        'premiumState',
        'premiumVerifiedAt'
      ];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // New accounts may only create the safe default role/subscription and may
      // not pre-seed any server-owned Play entitlement metadata.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.vipStatus == 'none'
        && !request.resource.data.keys().hasAny([
          'premiumUntil',
          'premiumProductId',
          'premiumBasePlanId',
          'premiumState',
          'premiumVerifiedAt'
        ]);

      // Users cannot promote themselves, extend an expired subscription, or
      // rewrite product/state verification metadata. Server service accounts use
      // IAM and are not restricted by these client security rules.
      allow update: if isAdmin() || (isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(premiumFields())
        && request.resource.data.role == resource.data.role
        && request.resource.data.energy is int
        && request.resource.data.energy >= 0
        && request.resource.data.energy <= 500);

      allow delete: if isOwner(userId) || isAdmin();

      match /readings/{readingId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.type is string
          && request.resource.data.result is string
          && request.resource.data.result.size() <= 12000;
        allow update: if false;
      }
    }

    // Block all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
